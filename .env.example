# Supabase project credentials
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here  # NEVER commit this

# Paystack
# Get from: Paystack Dashboard → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY=sk_live_your_key_here  # NEVER commit this
PAYSTACK_PUBLIC_KEY=pk_live_your_key_here

# Frontend URL (used for CORS allowlist in Edge Functions)
FRONTEND_URL=https://sj-consulting.vercel.app
